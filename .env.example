# Web UI (main_101_web_ui.py) 専用の設定です。 001〜003 のスクリプトはこのファイルを読みません。
# (スクリプトの秘密情報は、コマンドライン引数か、明示した環境変数 DISCORD_BOT_TOKEN で渡す思想のため。 compose.yaml の NOTE 参照。)
# cp .env.example .env して、実際の値を書いてください。

# WEB_DEFAULT_* はフォームの初期値です。未設定でも壊れません (フォームが空で出るだけ)。
WEB_DEFAULT_DISCORD_BOT_TOKEN=
WEB_DEFAULT_DISCORD_CHANNEL_ID=

# user セレクトボックスの選択肢です。 "表示名:ユーザID" をカンマ区切りで並べます。
# 表示名を省略して ID だけ書くこともできます。
WEB_DISCORD_USER_ID_CHOICES_CSV=noctis:12345,seraphina:67890
